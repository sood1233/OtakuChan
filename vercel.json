{
  "functions": {
    "api/prerender.js": {
      "includeFiles": "*.html"
    }
  },
  "routes": [
    { "src": "^/(.+)/$", "status": 308, "headers": { "Location": "/$1" } },

    { "src": "^/$", "dest": "/api/prerender?type=home" },

    { "src": "^/admin$", "dest": "/admin.html", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } },
    { "src": "^/admin\\.html$", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }, "continue": true },

    { "src": "^/ads\\.txt$", "headers": { "Content-Type": "text/plain; charset=utf-8" }, "continue": true },

    { "handle": "filesystem" },

    { "src": "^/robots\\.txt$",  "dest": "/api/robots" },
    { "src": "^/sitemap\\.xml$", "dest": "/api/sitemap" },

    { "src": "^/home$",               "dest": "/api/prerender?type=home" },

    { "src": "^/notifications$",      "dest": "/notifications.html" },
    { "src": "^/bookmarks$",          "dest": "/bookmarks.html" },
    { "src": "^/settings$",           "dest": "/settings.html" },
    { "src": "^/search$",             "dest": "/search.html" },
    { "src": "^/rules$",              "dest": "/rules.html" },
    { "src": "^/about$",              "dest": "/about.html" },
    { "src": "^/contact$",            "dest": "/contact.html" },
    { "src": "^/privacy$",            "dest": "/privacy.html" },
    { "src": "^/terms$",              "dest": "/terms.html" },
    { "src": "^/login$",              "dest": "/login.html" },
    { "src": "^/signup$",             "dest": "/signup.html" },
    { "src": "^/communities$",        "dest": "/communities.html" },
    { "src": "^/communities/(?<slug>[^/]+)$", "dest": "/api/prerender?type=community&slug=$slug" },

    { "src": "^/lists$",              "dest": "/lists.html" },
    { "src": "^/i/lists/(?<id>[^/]+)$", "dest": "/api/prerender?type=list&id=$id" },
    { "src": "^/(?<username>[^/]+)/lists$", "dest": "/profilelists.html" },

    { "src": "^/messages$",           "dest": "/chat.html" },
    { "src": "^/messages/(?<username>[^/]+)$", "dest": "/chat.html" },

    { "src": "^/(?<username>[^/]+)/followers$", "dest": "/followlist.html" },
    { "src": "^/(?<username>[^/]+)/following$", "dest": "/followlist.html" },

    { "src": "^/i/status/(?<id>[^/]+)$", "dest": "/api/prerender?type=thread&id=$id" },
    { "src": "^/(?<username>[^/]+)/status/(?<id>[^/]+)$", "dest": "/api/prerender?type=thread&username=$username&id=$id" },

    { "src": "^/(?<username>[^/]+)$", "dest": "/api/prerender?type=profile&username=$username" }
  ]
}
