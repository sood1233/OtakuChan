{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt",   "destination": "/api/robots" },
    { "source": "/sitemap.xml",  "destination": "/api/sitemap" },

    { "source": "/admin",              "destination": "/admin.html" },

    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([bB][oO][tT]|[cC]rawl|[sS]pider|facebookexternalhit|WhatsApp|SkypeUriPreview|Embedly|Pinterest|W3C_Validator).*" }],
      "destination": "/api/prerender?type=home"
    },
    {
      "source": "/home",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([bB][oO][tT]|[cC]rawl|[sS]pider|facebookexternalhit|WhatsApp|SkypeUriPreview|Embedly|Pinterest|W3C_Validator).*" }],
      "destination": "/api/prerender?type=home"
    },

    { "source": "/home",               "destination": "/index.html" },
    { "source": "/notifications",      "destination": "/notifications.html" },
    { "source": "/bookmarks",          "destination": "/bookmarks.html" },
    { "source": "/settings",           "destination": "/settings.html" },
    { "source": "/search",             "destination": "/search.html" },
    { "source": "/rules",              "destination": "/rules.html" },
    { "source": "/about",              "destination": "/about.html" },
    { "source": "/contact",            "destination": "/contact.html" },
    { "source": "/privacy",            "destination": "/privacy.html" },
    { "source": "/terms",              "destination": "/terms.html" },
    { "source": "/login",              "destination": "/login.html" },
    { "source": "/signup",             "destination": "/signup.html" },
    { "source": "/communities",        "destination": "/communities.html" },
    { "source": "/communities/:slug",  "destination": "/community.html" },

    { "source": "/lists",              "destination": "/lists.html" },
    { "source": "/i/lists/:id",        "destination": "/list.html" },
    { "source": "/:username/lists",    "destination": "/profilelists.html" },

    { "source": "/messages",           "destination": "/chat.html" },
    { "source": "/messages/:username", "destination": "/chat.html" },

    { "source": "/:username/followers",  "destination": "/followlist.html" },
    { "source": "/:username/following",  "destination": "/followlist.html" },

    {
      "source": "/i/status/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([bB][oO][tT]|[cC]rawl|[sS]pider|facebookexternalhit|WhatsApp|SkypeUriPreview|Embedly|Pinterest|W3C_Validator).*" }],
      "destination": "/api/prerender?type=thread&id=:id"
    },
    {
      "source": "/:username/status/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([bB][oO][tT]|[cC]rawl|[sS]pider|facebookexternalhit|WhatsApp|SkypeUriPreview|Embedly|Pinterest|W3C_Validator).*" }],
      "destination": "/api/prerender?type=thread&username=:username&id=:id"
    },
    {
      "source": "/:username",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([bB][oO][tT]|[cC]rawl|[sS]pider|facebookexternalhit|WhatsApp|SkypeUriPreview|Embedly|Pinterest|W3C_Validator).*" }],
      "destination": "/api/prerender?type=profile&username=:username"
    },

    { "source": "/i/status/:id",         "destination": "/thread.html" },
    { "source": "/:username/status/:id", "destination": "/thread.html" },

    { "source": "/:username",          "destination": "/profile.html" }
  ]
}
